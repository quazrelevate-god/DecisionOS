<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-10-29 (founder) — the pill as glass, not ink. A launcher draws a
     widget flat (RemoteViews have no blur), so the glass is built the way the
     eye reads it: a see-through frosted fill, a sheen across the top half, and
     a bright hairline edge, over whatever wallpaper is behind it.
     Then (founder): "fully transparent — add some black, 40% transparent":
     the fill is black at about 60%, so the wallpaper still shows through.
     And a rectangle with a small radius rather than a pill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#A0000000" android:endColor="#8C000000" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="22dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#1FFFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="15dp" android:topRightRadius="15dp" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
