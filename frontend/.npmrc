# FIX-FUP-13: legacy-peer-deps is required because react-day-picker@8.10.1
# peer-requires date-fns@^2 or ^3, but this project uses date-fns@4. npm 7+
# refuses to install by default when peers don't match; older resolution
# (which just installs both and skips the peer check) is what CRA + Radix
# stacks actually work with. Set here so `npm install` works with no flags
# for every developer + CI job — the failure mode without this is a silent
# exit-0 that installs zero packages.
legacy-peer-deps=true

# Keep noise down in CI/dev logs.
fund=false
audit=false
