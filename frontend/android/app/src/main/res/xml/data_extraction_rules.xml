<?xml version="1.0" encoding="utf-8"?>
<!--
  B08 · Android 12+ reads this instead of android:allowBackup for the two
  transfer paths it names. Both are refused for the same reason: the session
  and the cached workspace data live in the WebView's storage, and a business's
  ledger should not move between devices except through a sign-in.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
